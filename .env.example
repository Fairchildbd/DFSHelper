# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# API server
PORT=4000

# Seasons to ingest weekly stats for (comma separated, or a range start)
INGEST_SEASON_START=2015

# How many seasons of per-week stats to keep. The weekly tables only grow, so
# this ceiling is what stops storage creeping into the plan cap. Defaults to
# PRODUCTION_WINDOW_SEASONS + 2 (minimum 4); enforced by the weekly refresh.
# RETENTION_SEASONS=4

# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=
COLLEGE_SEASON_START=2015

# --- Accounts and billing ---

# How long a session token stays valid. The app stores the token in the device
# keychain and silently re-authenticates on launch until it expires.
SESSION_TTL_DAYS=30

# Gates lineup building behind an active subscription. Leave false until web
# checkout exists: with it off, every signed-in user can build lineups.
PAYWALL_ENABLED=false

# Whether the app may show a link to the external purchase page. Server-driven
# so a storefront policy change is a config edit rather than an app release.
# Apple's rules on linking out differ by storefront and have changed recently —
# confirm the current guideline before turning this on.
SHOW_EXTERNAL_PURCHASE_LINK=false
PURCHASE_URL=
