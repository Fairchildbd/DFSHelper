# Where the app looks for the DFS Matchup API.
#
# Defaults (see src/api.ts) only work when the app and the server share a host:
# localhost:4000 for the iOS simulator, 10.0.2.2:4000 for the Android emulator.
# A physical device resolves localhost to itself, so it needs the LAN address of
# the machine running `npm --prefix packages/server run dev`:
#
#   ipconfig getifaddr en0
#
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
